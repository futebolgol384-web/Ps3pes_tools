name: Build PS3 PKG

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    container:
      image: mlafeldt/ps3dev
    steps:
      - uses: actions/checkout@v4
      - name: Compilar e gerar PKG
        run: make pkg
      - name: Guardar o PKG
        uses: actions/upload-artifact@v4
        with:
          name: ps3-pkg
          path: '*.pkg'
